# Database. Local development uses SQLite. For Neon later, use:
# postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=sqlite:///./fdr.db

# Login tokens are signed with this. Use a long random string (32+ characters).
AUTH_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# Demo accounts (admin, officer1, approver1, institution1). Set to 0 once real users exist.
SEED_DEMO=1

# Frontend address(es) allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000

# Uploaded FDR files are kept here until cloud storage is added.
UPLOAD_DIR=./uploads

# Daily maturity check: time in Indian Standard Time, and whether it runs at all.
DAILY_CHECK_TIME=08:00
SCHEDULER_ENABLED=1

# Email alerts. Without a SendGrid key, emails are only logged in the database (see /api/admin/emails).
SENDGRID_API_KEY=
EMAIL_FROM=fdr-portal@example.com
